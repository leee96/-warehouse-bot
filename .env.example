# Discord Bot
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here

# Opcionális: csak development-hez; hagyd üresen globális deploy-hoz
GUILD_ID=your_guild_id_here

# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/warehouse_bot?schema=public"

# Logging
LOG_LEVEL=info
NODE_ENV=development

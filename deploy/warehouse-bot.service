[Unit]
Description=Warehouse Discord Bot
Documentation=https://github.com/your-org/warehouse-bot
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=warehousebot
Group=warehousebot
WorkingDirectory=/opt/warehouse-bot
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

# Biztonság
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/warehouse-bot

# Környezeti változók
EnvironmentFile=/opt/warehouse-bot/.env

# Logging — journald-be megy, logrotate kezeli
StandardOutput=journal
StandardError=journal
SyslogIdentifier=warehouse-bot

[Install]
WantedBy=multi-user.target
